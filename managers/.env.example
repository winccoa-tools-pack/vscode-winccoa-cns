# CNS HTTP Server configuration
# Copy this file to .env and fill in your values.
#
# NOTE: WinCC OA Node.js managers cannot receive command-line arguments.
#       All configuration must be set via this .env file placed alongside
#       cns-server.js in the WinCC OA project's javascript/ directory.

# Port on which the HTTP server listens.
CNS_SERVER_PORT=4712

# Shared secret token.  Set the same value in the VS Code setting
# "winccoaCns.token".  Use a random UUID or similar long random string.
CNS_SERVER_TOKEN=change-me-to-a-random-secret
