{
  "name": "winccoa-cns",
  "displayName": "WinCC OA CNS Browser",
  "description": "Browse the WinCC OA Component Naming System (CNS) tree with live updates",
  "publisher": "jakobmattes",
  "version": "0.1.0",
  "preview": true,
  "author": "Jakob Mattes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/winccoa-tools-pack/vscode-winccoa-cns.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "wincc",
    "wincc oa",
    "scada",
    "cns",
    "component naming system"
  ],
  "icon": "resources/cns.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "compile": "npm run typecheck && npm run build",
    "package": "npx @vscode/vsce package --out bin/",
    "start": "code --extensionDevelopmentPath=.",
    "start:insiders": "code-insiders --extensionDevelopmentPath=."
  },
  "dependencies": {
    "@winccoa-tools-pack/npm-winccoa-core": "0.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.8.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "winccoa-cns",
          "title": "WinCC OA CNS",
          "icon": "resources/cns.svg"
        }
      ]
    },
    "views": {
      "winccoa-cns": [
        {
          "id": "winccoaCns",
          "name": "CNS Tree",
          "icon": "resources/cns.svg",
          "contextualTitle": "WinCC OA CNS Browser"
        },
        {
          "id": "winccoaCnsDetails",
          "name": "Node Details",
          "type": "webview",
          "contextualTitle": "WinCC OA CNS — Node Details"
        }
      ]
    },
    "commands": [
      {
        "command": "winccoaCns.refresh",
        "title": "Refresh CNS Tree",
        "icon": "$(refresh)",
        "category": "WinCC OA CNS"
      },
      {
        "command": "winccoaCns.copyDpName",
        "title": "Copy Datapoint Name",
        "category": "WinCC OA CNS"
      },
      {
        "command": "winccoaCns.copyCnsPath",
        "title": "Copy CNS Path",
        "category": "WinCC OA CNS"
      },
      {
        "command": "winccoaCns.addManager",
        "title": "Add CNS Manager to WinCC OA Project",
        "category": "WinCC OA CNS"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "winccoaCns.refresh",
          "when": "view == winccoaCns",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "winccoaCns.copyDpName",
          "when": "view == winccoaCns && viewItem =~ /cnsNode|cnsTree/",
          "group": "copy@1"
        },
        {
          "command": "winccoaCns.copyCnsPath",
          "when": "view == winccoaCns && viewItem =~ /cns/",
          "group": "copy@2"
        }
      ]
    },
    "configuration": {
      "title": "WinCC OA CNS",
      "properties": {
        "winccoaCns.serverUrl": {
          "type": "string",
          "default": "http://localhost:4712",
          "description": "URL of the WinCC OA CNS HTTP manager (cns-server.js). Example: http://localhost:4712"
        },
        "winccoaCns.token": {
          "type": "string",
          "default": "",
          "description": "Bearer token for authenticating with the CNS manager. Must match CNS_SERVER_TOKEN in the manager .env file.",
          "markdownDescription": "Bearer token for authenticating with the CNS manager. Must match `CNS_SERVER_TOKEN` in the manager `.env` file."
        }
      }
    }
  }
}
